# Imported by outreach's Caddy, which owns ports 80/443 on the VPS:
# its Caddyfile ends in `import /etc/caddy/sites/*.caddy`, and ~/caddy-sites on
# the host is mounted there. The deploy workflow copies this file in and
# reloads that Caddy. `portfolio` resolves over the shared `edge` network.
#
# TLS is a Cloudflare origin certificate (15 years, apex + wildcard), not
# Let's Encrypt: Cloudflare proxies every request under Full (strict), so the
# origin only ever has to satisfy Cloudflare. Both files sit in
# ~/caddy-sites/certs/, mode 600.
#
# Apex serves the site. www redirects to it — one canonical host, so search
# engines and analytics do not split the domain in two.

www.fadaeixlii.dev {
	tls /etc/caddy/sites/certs/fadaeixlii.dev.pem /etc/caddy/sites/certs/fadaeixlii.dev.key
	redir https://fadaeixlii.dev{uri} permanent
}

fadaeixlii.dev {
	tls /etc/caddy/sites/certs/fadaeixlii.dev.pem /etc/caddy/sites/certs/fadaeixlii.dev.key
	encode zstd gzip
	# Cloudflare's edge IPs are the only thing allowed to set/append
	# x-forwarded-for here; clientIp() (src/lib/http/client-ip.ts) still
	# prefers cf-connecting-ip first and only falls back to the last
	# x-forwarded-for hop. https://www.cloudflare.com/ips/
	reverse_proxy portfolio:3000 {
		trusted_proxies 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
	}

	header {
		# .dev is on the HSTS preload list already; stating it is belt and braces.
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	# Next.js fingerprints these filenames, so they can be cached hard.
	@immutable path /_next/static/* /fonts/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
}
