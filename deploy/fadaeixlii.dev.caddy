# Apex serves the site. www redirects to it — one canonical host, so search
# engines and analytics do not split the domain in two.

www.mohammadmkh.dev {
	tls /etc/ssl/cloudflare/origin.pem /etc/ssl/cloudflare/origin.key
	redir https://mohammadmkh.dev{uri} permanent
}

mohammadmkh.dev {
	tls /etc/ssl/cloudflare/origin.pem /etc/ssl/cloudflare/origin.key
	encode zstd gzip
	# Cloudflare's edge IPs are the only thing allowed to set/append
	# x-forwarded-for here; clientIp() (src/lib/http/client-ip.ts) still
	# prefers cf-connecting-ip first and only falls back to the last
	# x-forwarded-for hop. https://www.cloudflare.com/ips/
	reverse_proxy portfolio:3000 {
		trusted_proxies 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
	}

	header {
		# .dev is on the HSTS preload list already; stating it is belt and braces.
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}

	# Next.js fingerprints these filenames, so they can be cached hard.
	@immutable path /_next/static/* /fonts/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
}
