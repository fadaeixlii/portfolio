# Local development. On the VPS the same keys live in ~/portfolio/.env (mode 600),
# with every value in single quotes — compose would otherwise expand the `$`
# signs inside ADMIN_PASSWORD_HASH. See docs/deployment.md.

# Database (Postgres in Docker — `pnpm db:up`, then `pnpm db:migrate`).
# Port 5433 because this machine already runs other Postgres containers on 5432.
# Hex only in the password: it is pasted into DATABASE_URL unescaped.
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=
POSTGRES_DB=portfolio
POSTGRES_PORT=5433
DATABASE_URL=postgres://portfolio:<password>@127.0.0.1:5433/portfolio

# Admin login (/admin). Comma-separated allowlist; the password hash comes from
# `pnpm --silent admin:hash >> .env.local`. SESSION_SECRET signs the cookie:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_EMAILS=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Site
NEXT_PUBLIC_SITE_URL=https://fadaeixlii.dev

# Contact email (Resend — https://resend.com, free tier). Optional:
# if RESEND_API_KEY is unset the form still works (saves to Postgres), just no email.
# Sandbox works with no domain setup: from=onboarding@resend.dev can only send to
# the email that owns your Resend account (set CONTACT_TO_EMAIL to that same address).
RESEND_API_KEY=
CONTACT_TO_EMAIL=mmohammadkhani408@gmail.com
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Booking calendar — docs/google-calendar-setup.md. The refresh token comes from
# `pnpm calendar:auth`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=
GOOGLE_REFRESH_TOKEN=

# Booking cancel/reschedule links (HMAC-SHA256 over the booking id).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BOOKING_TOKEN_SECRET=
